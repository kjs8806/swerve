# Godot 4 local cache/import artifacts - regenerated automatically, never commit.
.godot/
*.import
# Exception: these assets need a non-default import setting (mipmaps
# enabled) to avoid moire/aliasing when the game scales them down for
# display, so their .import files are committed instead of left to
# regenerate with defaults.
!assets/hud/progress-track-hd.png.import
!assets/hud/progress-car-hd.png.import
!assets/environment/*-hd.png.import

# Export build output (produced by the export-apk workflow / local exports).
/builds/
